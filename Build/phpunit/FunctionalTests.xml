<?xml version="1.0"?>
<!--
    Functional tests of EXT:pageclasses (PHPUnit 11).
    Run with Build/Scripts/runTests.sh -s functional, which provides the environment
    (SQLite, TYPO3_PATH_ROOT).

    Every notice, warning and deprecation caused by the code of the extension fails
    the run. Deprecations raised inside TYPO3 itself are not counted.
-->
<phpunit
    backupGlobals="true"
    bootstrap="../../.Build/vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
    cacheResult="false"
    colors="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerErrors="true"
    displayDetailsOnTestsThatTriggerNotices="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    failOnDeprecation="true"
    failOnNotice="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="Functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>../../Classes/</directory>
            <directory>../../Configuration/</directory>
            <directory>../../Tests/</directory>
            <file>../../ext_localconf.php</file>
        </include>
    </source>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
    </php>
</phpunit>
