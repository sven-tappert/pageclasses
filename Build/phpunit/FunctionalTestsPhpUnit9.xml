<?xml version="1.0"?>
<!--
    Functional tests of EXT:pageclasses for PHPUnit 9 (TYPO3 11).
    Run with Build/Scripts/runTests.sh -s functional -t 11. See FunctionalTests.xml for TYPO3 12.

    Every PHP error, warning, notice and deprecation fails the test.
-->
<phpunit
    backupGlobals="true"
    bootstrap="../../.Build/vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
    cacheResult="false"
    colors="true"
    convertDeprecationsToExceptions="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="Functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
    </php>
</phpunit>
