# PHPStan against TYPO3 13: Pageclasses::resolvePageContext() keeps the TYPO3 12
# fallback through TypoScriptFrontendController, which is deprecated in v13.
# Drop this file together with TYPO3 12 support.
includes:
    - phpstan.neon

parameters:
    ignoreErrors:
        -
            identifier: property.deprecatedClass
            message: '#TypoScriptFrontendController#'
            path: ../Classes/Plugin/Pageclasses.php
            count: 3
