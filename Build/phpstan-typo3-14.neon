# PHPStan against TYPO3 14: Pageclasses::resolvePageContext() keeps the TYPO3 12
# fallback through the request attribute "frontend.controller" and the class
# TypoScriptFrontendController, both gone in v14 (Breaking #107831).
# Drop this file together with TYPO3 12 support.
includes:
    - phpstan.neon

parameters:
    ignoreErrors:
        -
            message: '#TypoScriptFrontendController#'
            path: ../Classes/Plugin/Pageclasses.php
        -
            message: '#request attribute "frontend\.controller"#'
            path: ../Classes/Plugin/Pageclasses.php
