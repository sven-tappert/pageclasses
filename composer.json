{
    "name": "svent/pageclasses",
    "description": "Add CSS classes to the body tag - Adding one or more CSS classes to the body tag of the rendered pages. The extension provides inheritance, separate handling of subpages and includes classes for frontend- and backend-layouts.",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "TYPO3 extension",
        "body tag",
        "CSS",
        "pageclasses"
    ],
    "authors": [
        {
            "name": "Sven Tappert",
            "email": "tappert@sven-t.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/sven-tappert/pageclasses",
    "support": {
        "issues": "https://github.com/sven-tappert/pageclasses/issues",
        "source": "https://github.com/sven-tappert/pageclasses",
        "docs": "https://docs.typo3.org/p/svent/pageclasses/main/en-us/"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^10.0.0@alpha",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "saschaegerer/phpstan-typo3": "^3.0.1",
        "squizlabs/php_codesniffer": "^3.13",
        "typo3/testing-framework": "^9.7"
    },
    "autoload": {
        "psr-4": {
            "SvenT\\Pageclasses\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SvenT\\Pageclasses\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "process-timeout": 0,
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "pageclasses",
            "version": "13.2.0",
            "Package": {
                "providesPackages": {}
            },
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "deps:install": "Build/Scripts/runTests.sh -s composerUpdate",
        "docs:render": "Build/Scripts/runTests.sh -s docs",
        "hooks:install": "git config core.hooksPath .githooks",
        "test": [
            "@test:lint",
            "@test:phpstan",
            "@test:phpcompat",
            "@test:functional"
        ],
        "test:all": "Build/Scripts/testMatrix.sh",
        "test:functional": "Build/Scripts/runTests.sh -s functional",
        "test:lint": "Build/Scripts/runTests.sh -s lint",
        "test:phpcompat": "Build/Scripts/runTests.sh -s phpcompat",
        "test:phpstan": "Build/Scripts/runTests.sh -s phpstan"
    },
    "scripts-descriptions": {
        "deps:install": "Install the dependencies in .Build/ (default PHP 8.4, other version: -- -p 8.2)",
        "docs:render": "Render Documentation/ to Documentation-GENERATED-temp/",
        "hooks:install": "Activate the pre-commit hook in .githooks/",
        "test": "Lint, PHPStan, PHPCompatibility and functional tests for the installed TYPO3/PHP combination",
        "test:all": "All checks for every supported TYPO3/PHP combination",
        "test:functional": "Functional tests (other version: -- -p 8.2)",
        "test:lint": "PHP syntax check (other version: -- -p 8.2)",
        "test:phpcompat": "PHPCompatibility for the whole supported PHP range",
        "test:phpstan": "PHPStan (other version: -- -p 8.2)"
    }
}
