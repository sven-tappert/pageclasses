#!/usr/bin/env bash
#
# Runs a quick subset of the checks before a commit is accepted:
# lint, phpstan and the functional tests for the TYPO3/PHP combination
# installed in .Build/ (see runTests.sh -h), docs only if Documentation/ is
# part of the commit. The full matrix runs in Build/Scripts/testMatrix.sh and
# on GitHub.
#
# Activated by "Build/Scripts/runTests.sh -s composerUpdate" or manually with
# "git config core.hooksPath .githooks". Skip once with "git commit --no-verify".
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"
RUN=Build/Scripts/runTests.sh

abort() {
  printf '\nCommit aborted: %s\nFix the issue or skip the checks with "git commit --no-verify".\n' "$1" >&2
  exit 1
}

docker info > /dev/null 2>&1 || abort "docker is not running, the checks need it."

# runTests.sh uses the installed TYPO3/PHP combination and installs the
# dependencies first if needed (nothing installed yet, branch switched)
"$RUN" -s lint || abort "lint failed."
"$RUN" -s phpstan || abort "phpstan failed."
"$RUN" -s functional || abort "functional tests failed."

if git diff --cached --name-only | grep -q '^Documentation/'; then
  "$RUN" -s docs || abort "the documentation does not render without warnings."
fi
